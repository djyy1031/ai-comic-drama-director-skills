      "使用条件": ["核心是延迟信息、身份不确定或危险逼近"],
      "禁用条件": ["危险身份已经明确且正在直接交锋", "只需要普通夜景"],
      "主要输出": ["正常基线", "异常细节", "声画错位", "察觉", "延迟揭示", "反应"]
    },
    {
      "模块名称": "追逐与逃生",
      "触发关键词": ["追", "逃", "奔跑", "躲藏", "搜寻", "逼近", "甩开"],
      "使用条件": ["人物目标和行进方向明确", "相对距离在变化"],
      "禁用条件": ["只是普通走路或转场", "空间方向无法确定"],
      "主要输出": ["路线", "障碍", "相对距离", "速度变化", "空间锚点", "体力"]
    },
    {
      "模块名称": "多人空间调度",
      "触发关键词": ["群像", "围堵", "全班", "众人", "混战", "人群", "同学若干"],
      "使用条件": ["三名以上人物同时影响主要画面", "需要锁定前中后景和进出方向"],
      "禁用条件": ["背景人物不影响剧情且可弱化", "单人或稳定双人镜头"],
      "主要输出": ["主次层级", "前中后景", "左右关系", "进出方向", "群演动作密度"]
    },
    {
      "模块名称": "环境物理反馈",
      "触发关键词": ["冲击", "爆发", "重击", "风压", "尘土", "碎屑", "震动", "破坏"],
      "使用条件": ["力量足以影响衣物、发丝、空气、地面或陈设"],
      "禁用条件": ["轻微动作不应造成大范围反馈", "环境反馈会夸大剧情结果"],
      "主要输出": ["方向一致的风压", "布料发丝", "尘土碎屑", "光影", "声音", "衰减"]
    },
    {
      "模块名称": "喜剧反差回收",
      "触发关键词": ["吐槽", "尴尬", "白痴", "无语", "误会", "玩笑", "满头黑线"],
      "使用条件": ["笑点来自预期被打破或人物关系反差"],
      "禁用条件": ["场景保持严肃且没有喜剧功能", "需要长停顿才能勉强成立"],
      "主要输出": ["正常预期", "反差动作或台词", "短促反应", "关系落点"]
    },
    {
      "模块名称": "参考版本继承",
      "触发关键词": ["参考上一版", "保留", "修改版", "不要改", "导演反馈", "跑出来效果好", "沿用"],
      "使用条件": ["存在旧提示词、旧视频、截图或明确修改反馈"],
      "禁用条件": ["没有可核对的参考来源"],
      "主要输出": ["锁定成功项", "必须保留", "仅参考", "允许修改", "失败项"]
    }
  ]
}
