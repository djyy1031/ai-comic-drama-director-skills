{
  "规范版本": "1.0",
  "说明": "关键词只召回候选模块，必须同时检查使用条件和禁用条件。",
  "模块": [
    {
      "模块名称": "连续语言表演",
      "触发关键词": ["长台词", "独白", "解释", "指控", "劝说", "演讲"],
      "使用条件": ["一条完整语言内容需要跨多个景别", "情绪或语速在同一句内发生变化"],
      "禁用条件": ["普通短句一个自然镜头即可完成", "准备把同一句拆到两个分镜组"],
      "主要输出": ["完整音轨", "镜头顺序", "情绪节点", "连续口型", "听者反应"]
    },
    {
      "模块名称": "威胁与权力转移",
      "触发关键词": ["威胁", "逼近", "压迫", "质问", "跪下", "指向", "对峙"],
      "使用条件": ["人物强弱关系正在改变", "距离、机位或站位能表现权力"],
      "禁用条件": ["只有普通信息交流", "没有人物关系变化"],
      "主要输出": ["高低机位", "距离变化", "视线锁定", "重心", "反应验证"]
    },
    {
      "模块名称": "刀剑对峙",
      "触发关键词": ["拔剑", "举刀", "剑尖", "横刀", "持剑", "兵器威胁"],
      "使用条件": ["武器已出现但尚未形成完整攻防动作", "重点是威胁、距离或起势"],
      "禁用条件": ["已经出现挥砍、突刺、格挡或闪避", "武器只是背景道具"],
      "主要输出": ["持物手", "刃口方向", "攻击线", "脚步", "安全距离"]
    },
    {
      "模块名称": "刀剑交锋",
      "触发关键词": ["挥砍", "突刺", "格挡", "横斩", "劈砍", "闪避", "交锋"],
      "使用条件": ["至少发生一次明确攻击与应对", "能确定攻击方向和结果"],
      "禁用条件": ["只是拔剑或口头威胁", "剧本没有实际出招"],
      "主要输出": ["步法", "攻击轨迹", "格挡角度", "受力", "收势衔接"]
    },
    {
      "模块名称": "现实近身动作",
      "触发关键词": ["拳", "踢", "推", "摔", "擒拿", "扇", "撞击"],
      "使用条件": ["人体近距离接触或闪避", "动作结果需要真实受力"],
      "禁用条件": ["只是比划或语言描述", "世界观明确使用非现实悬浮动作"],
      "主要输出": ["重心", "髋肩", "接触点", "惯性", "缓冲", "环境碰撞"]
    },
    {
      "模块名称": "异能与法术因果",
      "触发关键词": ["异能", "法术", "灵力", "剑气", "法阵", "能量", "隐身", "护盾"],
      "使用条件": ["能力被实际发动或产生可见作用", "世界观允许该能力"],
      "禁用条件": ["只谈论能力但未发动", "特效会改变原剧本能力规则"],
      "主要输出": ["来源", "积聚", "路径", "作用", "环境反馈", "余波"]
    },
    {
      "模块名称": "恐怖异常揭示",
